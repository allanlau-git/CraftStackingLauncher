<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>craft-icon.ico</ApplicationIcon>
    <Product>Craft Stacking Launcher</Product>
    <AssemblyTitle>Craft Stacking Launcher</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="craft-icon.ico" />
  </ItemGroup>

</Project>
